{
  "name": "@caravan/resolver",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Deterministic fixed-point battle resolver. Pure: zero runtime dependencies, no I/O, no clock, no RNG, no floats.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./replay": "./src/replay.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint . && node scripts/lint-selftest.mjs",
    "test": "vitest run",
    "determinism": "node scripts/determinism.mjs",
    "budget": "RESOLVER_BUDGET_STRICT=1 vitest run test/budget.test.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vitest": "^3.2.4"
  }
}
