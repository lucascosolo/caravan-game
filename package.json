{
  "name": "caravan-vaults",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "dev": "pnpm --filter @caravan/server dev",
    "dev:web": "pnpm --filter @caravan/web dev",
    "e2e": "node scripts/e2e.mjs",
    "db:migrate": "pnpm --filter @caravan/server db:migrate",
    "db:rollback": "pnpm --filter @caravan/server db:rollback",
    "db:reset": "pnpm --filter @caravan/server db:reset",
    "db:seed": "pnpm --filter @caravan/server db:seed",
    "db:status": "pnpm --filter @caravan/server db:status",
    "test:boundary": "node scripts/resolver-boundary-check.mjs",
    "determinism": "node scripts/determinism.mjs",
    "perf:resolver": "pnpm --filter @caravan/resolver run budget",
    "build": "node scripts/build.mjs && pnpm --filter @caravan/web build",
    "start": "node apps/server/dist/index.js",
    "smoke": "node scripts/smoke-server.mjs",
    "ci": "pnpm typecheck && pnpm lint && pnpm test:boundary && pnpm test && pnpm determinism && pnpm perf:resolver && pnpm build"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "^5.9.3"
  }
}
