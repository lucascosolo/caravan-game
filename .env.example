# Two Postgres roles (see apps/server/db/roles.sql):
#   caravan      owns the schema; runs migrations, `pnpm db:roles`, and the test reset.
#   caravan_app  DML-only login role the SERVER runs as. It cannot ALTER/TRUNCATE tables,
#                disable triggers, or create objects, so the schema's permanence guards
#                hold against the running process.

# The running server (and `pnpm db:seed`, which only does DML).
DATABASE_URL=postgres://caravan_app:caravan_app@localhost:5432/caravan

# Migrations and role setup: the owner role. Defaults to DATABASE_URL when unset, so set
# it whenever DATABASE_URL points at the app role.
MIGRATE_DATABASE_URL=postgres://caravan:caravan@localhost:5432/caravan

# Owner-role connection used by `pnpm test` (the suite resets this database's schema and
# re-applies db/roles.sql). Tests that prove the guards hold against the server's role
# connect to the same database as caravan_app (password override: TEST_APP_DB_PASSWORD).
TEST_DATABASE_URL=postgres://caravan:caravan@localhost:5432/caravan_test

# HTTP listen settings for `pnpm dev`.
PORT=3000
HOST=127.0.0.1

# ---------------------------------------------------------------------------------------------
# Copy this file to `.env` at the repo root to use it: every server entry point and script
# (pnpm dev, db:*, seed, admin, smoke, e2e, check) loads it, never overriding a variable that is
# already set in the environment. ENV_FILE=<path> names another file instead.
# ---------------------------------------------------------------------------------------------

# Single-process hosting (docs/PLAYTEST-HOSTING.md): serve apps/web/dist and mount the API under /api.
# SERVE_WEB=1
# WEB_DIST=apps/web/dist

# Packs: "sandbox" ($0 purchases; the default outside production) or "off" (previewed, not sold;
# the default under NODE_ENV=production, i.e. the play test).
# STORE_MODE=sandbox

# Behind exactly one reverse proxy (Caddy in the runbook): TRUST_PROXY=1.
# TRUST_PROXY=1
