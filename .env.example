# Postgres connection for the dev server, migrations and the seed script.
DATABASE_URL=postgres://caravan:caravan@localhost:5432/caravan

# Postgres connection used by `pnpm test` (the test suite resets this database).
TEST_DATABASE_URL=postgres://caravan:caravan@localhost:5432/caravan_test

# HTTP listen settings for `pnpm dev`.
PORT=3000
HOST=127.0.0.1
